<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000">

    <LinearLayout
        android:id="@+id/blockSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_sheet_bg"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="24dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#40FFFFFF"
            android:layout_marginBottom="24dp" />

        <ImageView
            android:id="@+id/ivBlockedIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:padding="8dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/tvBlockedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="App is blocked"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvBlockedSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This app is blocked during your active focus session."
            android:textAlignment="center"
            android:textColor="#B0B0B0"
            android:textSize="14sp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnUnblock"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Unblock manually"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D5A"
            android:layout_marginBottom="12dp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnExit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Exit"
            android:textColor="#B0B0B0"
            android:backgroundTint="#00000000"
            style="?android:attr/borderlessButtonStyle"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>
